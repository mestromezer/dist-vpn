---
# ansible-lint не удалось запустить в песочнице разработки (см. README →
# "Что реально проверено в этой песочнице") — Ansible controller официально
# не поддерживает Windows без WSL/Linux. Конфигурация ниже задокументирована
# для того, кто запустит `ansible-lint` на реальной Linux/macOS/WSL
# control-машине или в CI.
#
# ⚠️ Обновлено (первый реальный прогон в CI): profile: production реально
# проверен впервые именно тогда — предыдущая версия этого файла была
# написана "на бумаге", без возможности исполнить. Оставлен как есть
# (никаких других правок), кроме одного явного исключения ниже.
profile: production
exclude_paths:
  - .cache/
  - collections/
skip_list:
  # var-naming[no-role-prefix]: требует префиксовать КАЖДУЮ переменную роли
  # её именем (agent_image_source -> agent_install_agent_image_source и
  # т.д., 54 срабатывания на первом прогоне). Смысл правила — не дать
  # переменным разных ролей столкнуться, когда роли комбинируются с
  # чужими/сторонними (например, с Galaxy). У нас все три роли — свои,
  # `dependencies: []` во всех meta/main.yml, никаких сторонних ролей не
  # подключаем — коллизия физически невозможна, конфликтовать не с кем.
  # Официально документированный способ отключить конкретное правило,
  # которое не подходит проекту (docs.ansible.com/projects/lint/configuring),
  # не костыль. Полное переименование 54 переменных ради конвенции,
  # предназначенной для Galaxy-публикации (которой не будет), и понижение
  # всего profile (что попутно потеряло бы реальные security-правила уровня
  # safety/production, вроде risky-file-permissions/risky-shell-pipe) —
  # оба варианта хуже целевого исключения одного правила.
  - "var-naming[no-role-prefix]"
