# {{ ansible_managed }}
# Источник: roles/platform_install (defaults/main.yml: platform_domain). Не
# редактировать вручную.
#
{% if platform_domain %}
# platform_domain задан — Caddy сам получит настоящий Let's Encrypt-сертификат.
# Требует, чтобы DNS-запись {{ platform_domain }} уже указывала на {{ ansible_host }}
# ДО первого запуска Caddy (иначе ACME HTTP-01 challenge не пройдёт).
{{ platform_domain }} {
{% else %}
# platform_domain НЕ задан — Caddy поднимается на `tls internal` (самоподписанный
# сертификат, сгенерированный самим Caddy). Рабочий канал, но браузер предупредит о
# недоверенном сертификате, пока оператор не импортирует корневой сертификат Caddy
# вручную. См. SECRETS-ROTATION.md, maintenance-пункт "перейти на Let's Encrypt, когда
# появится домен" — тогда просто задать platform_domain и перепрогнать эту роль.
{{ ansible_host }} {
    tls internal
{% endif %}

    encode gzip

    @api path /api/v1/* /docs /openapi.json /redoc
    reverse_proxy @api localhost:{{ platform_http_port }}

    reverse_proxy localhost:{{ platform_admin_client_port }}

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
    }
}
