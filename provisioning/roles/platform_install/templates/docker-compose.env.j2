# {{ ansible_managed }}
# Источник: roles/platform_install. Не редактировать вручную.
#
# docker compose подхватывает файл `.env` рядом с docker-compose.yml автоматически
# (без явного --env-file) — используется здесь именно там, где базовый
# platform/docker-compose.yml УЖЕ параметризован через ${VAR:-default} (порты), в
# отличие от docker-compose.override.yml.j2 рядом (для литеральных значений, не
# подстановок — см. комментарий там).
#
# 127.0.0.1-префикс на HTTP/DB портах — то же самое "host_ip:host_port:container_port"
# синтаксис Compose, что подставляется в "${PLATFORM_HOST_HTTP_PORT:-8000}:8000" —
# закрывает эти два порта от внешнего доступа даже если ufw когда-нибудь
# отключат/переконфигурируют (defense-in-depth поверх group_vars/platform_nodes.yml,
# которая и так не открывает для них allow-правило). gRPC-порты (50051/50052) и Caddy
# (443/80, отдельный контейнер) продолжают слушать 0.0.0.0 — им и положено быть
# снаружи, ufw ограничивает их через role_firewall_rules (group_vars/platform_nodes.yml).
PLATFORM_HOST_HTTP_PORT=127.0.0.1:{{ platform_http_port }}
PLATFORM_HOST_DB_PORT=127.0.0.1:{{ platform_db_port }}
PLATFORM_HOST_GRPC_PORT={{ platform_grpc_port }}
PLATFORM_HOST_GRPC_ENROLLMENT_PORT={{ platform_grpc_enrollment_port }}

# Agent-ноды дозваниваются по публичному IP этого хоста (ansible_host) — серверный
# leaf-сертификат обязан покрывать его в SAN, иначе mTLS-хендшейк не пройдёт (см.
# platform/src/dist_vpn_platform/security/mtls_ca.py). Домен добавляется тоже, если
# задан platform_domain (см. defaults/main.yml) — понадобится и Caddy, и Agent'ам,
# если они когда-нибудь станут дозваниваться по имени вместо IP.
PLATFORM_MTLS_SERVER_SANS={{ ansible_host }}{{ ',' ~ platform_domain if platform_domain else '' }},localhost,127.0.0.1
