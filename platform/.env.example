# Copy to `.env` for local (non-docker-compose) development. Never commit the real
# `.env` (see repo .gitignore). docker-compose.yml sets its own equivalent values for
# the containerized stack - see there for the source of truth in that context.

PLATFORM_ENV=dev
PLATFORM_LOG_LEVEL=INFO

# --- Database (TZ-5 §2: PostgreSQL in production; see platform/README.md for the
# aiosqlite exception used specifically by the test suite) ---
PLATFORM_DATABASE_URL=postgresql+asyncpg://platform:platform@localhost:5432/platform

# --- HTTP API ---
PLATFORM_HTTP_HOST=0.0.0.0
PLATFORM_HTTP_PORT=8000

# --- gRPC (Agent <-> Platform) ---
PLATFORM_GRPC_HOST=0.0.0.0
PLATFORM_GRPC_PORT=50051
PLATFORM_GRPC_MAX_MESSAGE_BYTES=4194304

# --- JWT (TZ-5 §6.3) - MUST be a real random secret outside of dev ---
PLATFORM_JWT_SECRET_KEY=change-me-to-a-long-random-value
PLATFORM_JWT_ALGORITHM=HS256
PLATFORM_JWT_ACCESS_TTL_MINUTES=20
PLATFORM_JWT_REFRESH_TTL_DAYS=14

# --- Login rate limiting / lockout (TZ-5 §6.3) ---
PLATFORM_LOGIN_RATE_LIMIT_PER_IP=10/minute
PLATFORM_LOGIN_MAX_FAILED_ATTEMPTS=5
PLATFORM_LOGIN_LOCKOUT_MINUTES=15

# --- Default admin bootstrap (TZ-5 §6.3 - leave unset to auto-generate + print once
# at seed time; set only for reproducible local dev, never in production) ---
PLATFORM_DEFAULT_ADMIN_USERNAME=admin
# PLATFORM_DEFAULT_ADMIN_PASSWORD=

# --- Enrollment tokens (TZ-5 §4.1 / §6.2) ---
PLATFORM_ENROLLMENT_TOKEN_TTL_MINUTES=30

# --- mTLS CA (TZ-5 §6.2, see src/dist_vpn_platform/security/mtls_ca.py) ---
# Persistent directory for the generated CA keypair/cert + server leaf keypair/cert.
# Generated once on first startup if empty; never regenerated afterwards as long as
# this directory's contents survive. docker-compose.yml points this at a named volume
# instead (/var/lib/dist-vpn-platform/ca) - see there.
PLATFORM_MTLS_CA_DIR=var/ca
# Comma-separated hostnames/IPs the server leaf cert's SAN must cover - must include
# whatever hostname(s) Agents actually dial, plus localhost/127.0.0.1 for local dev.
PLATFORM_MTLS_SERVER_SANS=localhost,127.0.0.1
